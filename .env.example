APP_PORT=8090
APP_BIND=0.0.0.0
APP_URL=http://localhost:8090
# Override with a release tag or an immutable sha256 digest when required.
DATABASEDOC_IMAGE=ghcr.io/phillipunzen/database_doc:latest
COOKIE_SECURE=false
APP_DB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
# Fernet key: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=CHANGE_ME
SESSION_SECRET=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
# Optional: CA file for PostgreSQL/MySQL/MariaDB/MongoDB; mount read-only
SOURCE_CA_FILE=
# Entra ID: Single-tenant application, Web redirect URI: APP_URL/auth/entra/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Active Directory over LDAPS. The bind account needs read permissions only.
LDAP_HOST=
LDAP_PORT=636
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_CA_FILE=
# Mount the CA file read-only inside the container when needed.
